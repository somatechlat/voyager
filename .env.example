# ==============================================================================
# Voyager Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# All variables use the VOYAGER_ prefix.

# --- Core Settings ---
VOYAGER_ENV=local
VOYAGER_DEBUG=false
VOYAGER_SECRET_KEY=change-me-in-production-min-50-chars-long-secret-key
VOYAGER_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# --- Database ---
VOYAGER_DATABASE_URL=postgresql://voyager:voyager@localhost:5432/voyager

# --- Redis ---
VOYAGER_REDIS_URL=redis://:voyager@localhost:6379/0

# --- Security ---
VOYAGER_SECURITY_ENABLED=true
VOYAGER_SECURITY_SECURITY_ENABLED=true
VOYAGER_SECURITY_HSTS_ENABLED=true
VOYAGER_SECURITY_HSTS_MAX_AGE=31536000
VOYAGER_SECURITY_CORS_ENABLED=true
VOYAGER_SECURITY_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:8000"]
VOYAGER_SECURITY_CORS_ALLOW_CREDENTIALS=true
VOYAGER_SECURITY_RATE_LIMIT_ENABLED=true
VOYAGER_SECURITY_RATE_LIMIT_REQUESTS_PER_MINUTE=60
VOYAGER_SECURITY_JWT_ALGORITHM=RS256
VOYAGER_SECURITY_JWT_EXPIRATION_HOURS=8
VOYAGER_SECURITY_JWT_ISSUER=voyager-api
VOYAGER_SECURITY_JWT_AUDIENCE=voyager-clients
VOYAGER_SECURITY_SECRETS_BACKEND=env
VOYAGER_SECURITY_DATABASE_SSL_REQUIRE=false

# --- Email ---
VOYAGER_EMAIL_HOST=smtp.example.com
VOYAGER_EMAIL_PORT=587
VOYAGER_EMAIL_USE_TLS=true
VOYAGER_EMAIL_HOST_USER=
VOYAGER_EMAIL_HOST_PASSWORD=
VOYAGER_DEFAULT_FROM_EMAIL=noreply@example.com

# --- Stripe ---
VOYAGER_STRIPE_PUBLIC_KEY=pk_test_
VOYAGER_STRIPE_SECRET_KEY=sk_test_
VOYAGER_STRIPE_WEBHOOK_SECRET=whsec_

# --- OpenAI ---
VOYAGER_OPENAI_API_KEY=sk-
VOYAGER_OPENAI_ORG_ID=

# --- Vault ---
VOYAGER_VAULT_URL=http://localhost:8200
VOYAGER_VAULT_TOKEN=

# --- Keycloak ---
VOYAGER_KEYCLOAK_URL=http://localhost:8080
VOYAGER_KEYCLOAK_REALM=voyager
VOYAGER_KEYCLOAK_CLIENT_ID=voyager-api

# --- Vortex ---
VOYAGER_VORTEX_URL=http://localhost:11188

# --- CSRF ---
VOYAGER_CSRF_TRUSTED_ORIGINS=["http://localhost:3000"]
